# Banco (dev local com SQLite; produção com PostgreSQL)
DATABASE_URL=sqlite:///data/triage.db
# DATABASE_URL=postgresql+psycopg2://triage:senha@localhost:5432/triage
POSTGRES_PASSWORD=troque_esta_senha

# Pastas
INBOX_DIR=data/inbox
PROCESSED_DIR=data/processed

# Classificação: auto (LLM se houver chave+modelo, senão regras) | llm | rules
TRIAGE_MODE=auto
ANTHROPIC_API_KEY=
TRIAGE_MODEL=            # ID do modelo vigente na sua conta Anthropic
TRIAGE_WORKERS=8
REVIEW_THRESHOLD=0.6

# Premissas do cenário fictício (ROI simulado)
TICKETS_PER_WEEK=1300
MANUAL_SECONDS_PER_TICKET=45
REVIEW_SECONDS_PER_TICKET=20
